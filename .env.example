# Copy this file to .env and fill in only the provider you use.
# Never commit .env or an API key.

# OpenAI-compatible / Bailian endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# SiliconFlow endpoint (default provider in CogMemConfig)
# SILICONFLOW_API_KEY=

# Ollama endpoint (no key required for a local default installation)
# OLLAMA_BASE_URL=http://localhost:11434

# For ModelScope or another local OpenAI-compatible server, configure
# `modelscope_base_url` and `modelscope_api_key` in CogMemConfig.
